# Copy this file to .env and fill in real values. Never commit .env.
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DB=expendicure
MYSQL_PORT=3306

# Use a long random string (>= 32 chars). Rotate if it ever leaks.
SECRET_KEY=please-generate-a-long-random-secret

FLASK_DEBUG=True

# Fallback safety buffer (currency units) for the finance engine when a
# account has not set an account-level buffer.
SAFETY_BUFFER=2000

# --- Local AI (Phase 8) -------------------------------------------------------
# All optional. If Ollama is not installed / running, Expendicure still works
# fully; only /api/ai/* degrades. Pull the model first: `ollama pull mistral`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=60
